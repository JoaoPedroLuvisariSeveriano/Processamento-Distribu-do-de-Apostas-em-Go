# =============================================================================
# Variaveis de ambiente - EXEMPLO (nao commitar valores reais)
# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# =============================================================================

# --- Servidor HTTP ---
HTTP_PORT=3000
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:123@betting_postgres:5432/betting_db?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=5m

# --- AWS SQS (LocalStack) ---
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
# Credenciais dummy para LocalStack (nao sao validadas)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# URLs das filas SQS FIFO
SQS_WAGER_TRANSACTIONS_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_EVENTS_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# Configuracoes do consumidor SQS
SQS_MAX_MESSAGES=10
SQS_VISIBILITY_TIMEOUT=30
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_RETRIES=5

# --- Keycloak / OIDC ---
OIDC_ISSUER_URL=http://localhost:8080/realms/betting-realm
OIDC_CLIENT_ID=betting-service

# --- Workers ---
# Intervalo do worker de outbox (publicacao de eventos pendentes)
OUTBOX_WORKER_INTERVAL=5s
OUTBOX_WORKER_BATCH_SIZE=100

# Intervalo do worker de referencias pendentes
PENDING_REF_WORKER_INTERVAL=10s
PENDING_REF_MAX_ATTEMPTS=5

# --- Ambiente ---
ENV=development
LOG_LEVEL=debug
